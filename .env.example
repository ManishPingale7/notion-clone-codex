PORT=3000
HOST=127.0.0.1
DATABASE_PATH=./data/notion.sqlite
# Set to 1 only when serving behind HTTPS.
COOKIE_SECURE=0

# Optional PostgreSQL connection; leave unset for local SQLite.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=verify-full
# Use database-backed polling instead of local Socket.IO (build-time setting).
# VITE_COLLABORATION=polling
