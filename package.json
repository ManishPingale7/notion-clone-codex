{
  "name": "notion-local",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js --production",
    "test": "node --test tests/api.test.js",
    "test:ui": "node tests/run-browser.js",
    "check": "npm run build && npm test",
    "format": "prettier --write src server tests package.json vite.config.js playwright.config.js index.html README.md VERIFICATION.md",
    "format:check": "prettier --check src server tests package.json vite.config.js playwright.config.js index.html README.md VERIFICATION.md"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sanitize-html": "^2.17.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.9.9",
    "vite": "^6.3.5"
  }
}
