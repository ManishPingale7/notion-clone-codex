{
  "name": "notion-local",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js --production",
    "test": "node --test tests/*.test.js",
    "test:ui": "node tests/run-browser.js",
    "check": "npm run build && npm test",
    "format": "prettier --write src server api tests package.json vite.config.js playwright.config.js index.html README.md VERIFICATION.md HOSTING.md vercel.json",
    "format:check": "prettier --check src server api tests package.json vite.config.js playwright.config.js index.html README.md VERIFICATION.md HOSTING.md vercel.json",
    "prepare": "esbuild node_modules/sanitize-html/index.js --bundle --platform=node --format=cjs --outfile=server/sanitize.generated.cjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sanitize-html": "2.17.7",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.25.12",
    "prettier": "^3.9.9",
    "vite": "^6.3.5"
  }
}
